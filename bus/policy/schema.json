{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sommelier policy",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "#/$defs/uint"
    },
    "min_client": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "grace_min": {
      "$ref": "#/$defs/uint"
    },
    "mode": {
      "enum": [
        "off",
        "shadow",
        "enforce"
      ]
    },
    "timers": {
      "$ref": "#/$defs/timers"
    },
    "class": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/class"
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/trust"
      }
    },
    "kind": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/kind"
      }
    },
    "priority": {
      "$ref": "#/$defs/priority"
    }
  },
  "required": [
    "version",
    "min_client",
    "grace_min",
    "mode",
    "timers",
    "class",
    "trust",
    "kind",
    "priority"
  ],
  "additionalProperties": false,
  "$defs": {
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timers": {
      "type": "object",
      "properties": {
        "lease_min": {
          "$ref": "#/$defs/uint"
        },
        "poll_min": {
          "$ref": "#/$defs/uint"
        },
        "gone_min": {
          "$ref": "#/$defs/uint"
        },
        "offer_min": {
          "$ref": "#/$defs/uint"
        },
        "status_fresh_min": {
          "$ref": "#/$defs/uint"
        }
      },
      "required": [
        "lease_min",
        "poll_min",
        "gone_min",
        "offer_min",
        "status_fresh_min"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "meter": {
          "type": "string"
        },
        "stop_at": {
          "$ref": "#/$defs/uint"
        }
      },
      "required": [
        "meter",
        "stop_at"
      ],
      "additionalProperties": false
    },
    "class": {
      "type": "object",
      "properties": {
        "cap_per_owner": {
          "$ref": "#/$defs/uint"
        },
        "cap_per_family": {
          "$ref": "#/$defs/uint"
        },
        "cap_per_machine": {
          "$ref": "#/$defs/uint"
        },
        "quota_pause_min": {
          "$ref": "#/$defs/uint"
        },
        "spawn": {
          "type": "boolean"
        },
        "effort": {
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "lock": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "may_claim": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hold_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "may_claim",
        "hold_paths"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branch": {
          "type": "string"
        },
        "min_tier": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clean_room": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "branch",
        "min_tier",
        "checks"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        "aging_per_10min": {
          "$ref": "#/$defs/uint"
        },
        "aging_cap": {
          "$ref": "#/$defs/uint"
        }
      },
      "required": [
        "levels",
        "aging_per_10min",
        "aging_cap"
      ],
      "additionalProperties": false
    }
  }
}
